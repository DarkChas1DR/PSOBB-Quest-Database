  "supporting_bb_definitions": [
    {
      "constructor": "TOTrapChainSawDamage",
      "area_mask": "0x0000400C3F800000",
      "notes": "Chain saw damage trap. Params:\nparam2 = base damage (multiplied by difficulty: Normal = x1/5, Hard = x2/5, Very Hard = x3/5, Ultimate = x6/5)\nparam3 = model number (<= 0 for small saw, > 0 for large saw)\nparam4 = switch flag number (disabled when switch flag is enabled)\nparam5 high word = rotation range (16-bit angle)\nparam5 low word = rotation speed (angle units per frame)\nparam6 high word = if nonzero, ignore rotation range and rotate in a full circle instead\nparam6 low word = delay between cycles (seconds)",
      "inline_note": null,
      "line": 2101
    }
