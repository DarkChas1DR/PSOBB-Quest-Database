  "supporting_bb_definitions": [
    {
      "constructor": "TObjMapForceWarp",
      "area_mask": "0x00007FFC3FFF78FF",
      "notes": "Like 0x0003 (TObjMapWarpForest), but is invisible and automatically warps players when they enter its radius.\nThis is used to simulate floor warps in the Control Tower. Has the same params as TObjMapWarpForest, but also:\nparam5 = destination \"floor\" number (this is an intra-map warp and doesn't actually change floors; the \"floor\"\nnumber is only visual)\nparam6 = if <= 0, shows \"floor\" number (param5 formatted as \"%xF\") after warp; if > 0, param5 is ignored",
      "inline_note": null,
      "line": 2227
    }
  ],
