  "supporting_bb_definitions": [
    {
      "constructor": "TObjCityMainWarpChallenge",
      "area_mask": "0x0000600000040001",
      "notes": "Version of the main warp for Challenge mode. This object looks like the main Ragol warp on Pioneer 2, but\nbehaves similarly to boss teleporters: it shows the player a Yes/No confirmation menu and sends 6x6A to\nsynchronize state. There is a global named last_set_mainwarp_value which is set to param4 when this object is\nconstructed, but may be changed by a set_mainwarp quest opcode after that. If that happens, this object replaces\nits dest_floor with the floor specified in the last set_mainwarp quest opcode. Params:\nparam4 = destination floor\nparam5 = switch flag number",
      "inline_note": null,
      "line": 1303
    }
