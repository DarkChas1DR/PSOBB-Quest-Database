    {
      "constructor": "TObjWarpBoss03",
      "area_mask": "0x0000400000002000",
      "notes": "Invisible cross-floor warp. This is used for the warp behind the door to Ruins after defeating Vol Opt, and is\nonly available on that floor (on any other floor, 0x0160 constructs TObjFogCollisionPoison instead.) Params:\nparam4 = destination floor",
      "inline_note": null,
      "line": 1797
    },
    {
      "constructor": "TObjFogCollisionPoison",
      "area_mask": "0x00004FF030600700",
      "notes": "Switchable, foggy area that's visible and hurts the player if the switch flag isn't on. Params are the same as\nfor 0x0018 (TObjFogCollisionSwitch), but there is also:\nparam2 = poison power (scaled by difficulty: Normal = x1, Hard = x2, Very Hard = x3, Ultimate = x6)",
      "inline_note": null,
      "line": 1802
    }
