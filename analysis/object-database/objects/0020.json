  "supporting_bb_definitions": [
    {
      "constructor": "TOSwitchItem",
      "area_mask": "0x00006FFC3FFF07FF",
      "notes": "Item-detecting floor switch. Params:\nparam1 = radius\nparam4 = switch flag number\nparam5 = item type:\n0 or any value not listed below = any item\n1 = weapon\n2 = armor\n3 = shield\n4 = unit\n5 = mag\n6 = tool\n7 = meseta\nparam6 = item amount required minus 1 (0 = 1 item, 1 = 2 items, etc.); for tools and meseta, each dropped item\ncounts for its stack size",
      "inline_note": null,
      "line": 1005
    }
