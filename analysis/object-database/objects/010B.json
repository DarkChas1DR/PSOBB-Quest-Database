  "supporting_bb_definitions": [
    {
      "constructor": "TOSparkMachine01",
      "area_mask": "0x00004000000000C0",
      "notes": "Spark machine. This looks like it's intended to appear in the bridge room in Mine 1, to create an effect of the\ncolumnar machines sparking. This is implemented as four columns that randomly change their visibility, intended\nto be in the same position as the map geometry. Each column has an accumulator value, which is initially zero.\nEvery frame, the value (param1 - 0.98) is added to each column's accumulator and a random number between 0 and 1\nis chosen; if the random number is less than the column's accumulator, its visibility state is changed and its\naccumulator is reset to zero. In this manner, param1 can be thought of as the frequency of state changes - 0.98\nwould mean they never change state, 1.98 would mean they change every frame. Params:\nparam1 = state change accumulation per frame (value is param1 - 0.98)\nparam2 = if <= 0, only one column flickers and the others are always visible; if > 0, all columns flicker",
      "inline_note": null,
      "line": 1670
    }
  ],
