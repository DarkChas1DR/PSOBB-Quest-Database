  "supporting_bb_definitions": [
    {
      "constructor": "TObjEvtCollision",
      "area_mask": "0x00007FFFFFFF7FFF",
      "notes": "Event collision object. This object triggers a wave event (W-XXX) when any local player (in split-screen play,\nthere may be multiple) steps within its radius. The object is inactive for 3 frames after it is constructed, and\nwill not detect any player during that time. Curiously, the frame counter does not appear to be bounded, so if\nthe player waits approximately 828 days, the counter will overflow to a positive number and the object won't be\nable to trigger for another 828 days until it gets to zero again. It is unlikely this has ever happened for any\nplayer. Params:\nparam1 = radius\nparam4 = event ID",
      "inline_note": null,
      "line": 789
    }
  ],
