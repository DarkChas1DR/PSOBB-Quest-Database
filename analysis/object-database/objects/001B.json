  "supporting_bb_definitions": [
    {
      "constructor": "TObjAreaWarpQuest",
      "area_mask": "0x00005000000078FE",
      "notes": "Quest floor warp. This appears similar to TObjAreaWarpForest except that the object is not destroyed immediately\nif it's blue and the game is Challenge mode. Params:\nparam1 = player set ID (if this is >= 2, specifies which set of TObjPlayerSets to use on the destination\nfloor, which overrides the default behavior of 0/1 depending on the source and destination floor numbers;\nsee TObjPlayerSet for details)\nparam4 = destination floor\nparam6 = color (0 = blue, 1 = red)",
      "inline_note": null,
      "line": 969
    }
