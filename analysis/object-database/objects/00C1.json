  "supporting_bb_definitions": [
    {
      "constructor": "TODoorCave01",
      "area_mask": "0x0000400000000038",
      "notes": "Caves multiplayer door. Params:\nparam4 = base switch flag number (the actual switch flags used are param4, param4 + 1, param4 + 2, etc.; if\nthis is negative, the door is always unlocked)\nparam5 = 4 - number of switch flags (so if e.g. door should require only 3 switch flags, set param5 to 1)\nparam6 = synchronization mode:\nnegative = when all switch flags are enabled, door is permanently unlocked via 6x0B even if some switch\nflags are disabled later\nzero or positive = door only stays unlocked while all of the switch flags are active and locks again when\nany are disabled (no effect in single-player offline mode; the negative behavior is used instead)",
      "inline_note": null,
      "line": 1505
    }
  ],
